#!/usr/bin/env bash
# Runs Claude Code through the context-shaver proxy, starting the proxy first if
# nothing is listening on its port (bin/run-proxy). Arguments are passed to
# Claude Code. Claude Code turns tool search off behind a proxy unless told the
# proxy forwards it; this one does.
#
# An ANTHROPIC_BASE_URL already set, such as a company gateway, is kept as the
# proxy's upstream for this session, named in the path (src/via.ts); one
# already through this proxy, as a teammate session inherits, is left as it is.
#
# Claude Code is `claude` as typed at your prompt, run by your login shell so an
# alias or function for it there applies (one that keeps the machine awake, say),
# or SHAVER_REAL_CLAUDE_LOCATIONS if set: paths,
# or globs of versioned installs, separated by colons; the first with a match
# is taken, and of a glob's matches the newest. Set it when
# this stands in for Claude Code under a wrapper that sets the base URL itself
# once it starts (DESIGN.md); there, running `claude` would run the wrapper,
# which would run this again.
set -euo pipefail

me=$(readlink -f "$0")
bin=$(dirname "$me")
die() { echo "claude-via-shaver: $*" >&2; exit 1; }

if [[ -n ${SHAVER_REAL_CLAUDE_LOCATIONS:-} ]]; then
  # The first entry with a match wins; within a glob, the newest match.
  real=
  IFS=: read -ra entries <<<"$SHAVER_REAL_CLAUDE_LOCATIONS"
  for e in "${entries[@]}"; do
    while read -r c; do
      [[ -n $c && -x $c && $(readlink -f "$c") != "$me" ]] && real=$c
    done < <(compgen -G "${e/#\~/$HOME}" | sort -V)
    [[ -n $real ]] && break
  done
  [[ -n $real ]] ||
    die "SHAVER_REAL_CLAUDE_LOCATIONS ($SHAVER_REAL_CLAUDE_LOCATIONS) has no executable Claude Code"
else
  # exec keeps the PID, so a parent with the one this last ran `claude` as is
  # that `claude` running this again: a wrapper, which would loop. The depth
  # catches a wrapper that runs this through other processes.
  depth=${SHAVER_DEPTH:-0}
  [[ ${SHAVER_LAUNCHER_PID:-} != "$PPID" && $depth -lt 5 ]] ||
    die "run again by the claude it ran, as a wrapper runs the Claude Code it is given; set SHAVER_REAL_CLAUDE_LOCATIONS (DESIGN.md)"
  export SHAVER_LAUNCHER_PID=$$ SHAVER_DEPTH=$((depth + 1))
  real=("${SHELL:-bash}" -lic 'claude "$@"' claude)
fi

# Percent-encodes all but unreserved characters (RFC 3986), for a path segment.
encode() {
  local LC_ALL=C s=$1 out= c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9.~_-]) out+=$c ;;
      *) printf -v c '%%%02X' "'$c"; out+=$c ;;
    esac
  done
  printf %s "$out"
}

"$bin/run-proxy"
port=${SHAVER_PORT:-8787} up=${ANTHROPIC_BASE_URL:-}
up=${up%/}
if [[ -z $up ]]; then
  ANTHROPIC_BASE_URL=http://127.0.0.1:$port/harness/claude
elif [[ ! $up =~ ^http://(127\.0\.0\.1|localhost):$port(/|$) ]]; then
  ANTHROPIC_BASE_URL=http://127.0.0.1:$port/harness/claude/via/$(encode "$up")
fi
export ANTHROPIC_BASE_URL ENABLE_TOOL_SEARCH=${ENABLE_TOOL_SEARCH:-true}
exec "${real[@]}" "$@"
