#!/usr/bin/env bash
# Runs Claude Code through the context-shaver proxy, starting the proxy first if
# nothing is listening on its port (bin/run-proxy). Arguments are passed to
# Claude Code. Claude Code turns tool search off behind a proxy unless told the
# proxy forwards it; this one does, where ENABLE_TOOL_SEARCH isn't set already.
#
# An ANTHROPIC_BASE_URL already set, such as a company gateway, is kept as the
# proxy's upstream for this session, named in the path (src/via.ts); one
# already through this proxy, as a teammate session inherits, is left as it is.
#
# Claude Code is `claude` as typed at your prompt, run by your login shell so an
# alias or function for it there applies (one that keeps the machine awake, say),
# or SHAVER_REAL_CLAUDE_LOCATIONS if set: paths,
# or globs of versioned installs, separated by colons; the first with a match
# is taken, and of a glob's matches the newest. Set it when
# this stands in for Claude Code under a wrapper that sets the base URL itself
# once it starts (DESIGN.md); there, running `claude` would run the wrapper,
# which would run this again.
set -euo pipefail

me=$(readlink -f "$0")
bin=$(dirname "$me")
die() { echo "claude-via-shaver: $*" >&2; exit 1; }

# SHAVER_PRELAUNCH names a program this runs first, as
# `"$SHAVER_PRELAUNCH" --prelaunch claude`, so a launch through an alias or link
# to this checkout can update it: it may move the checkout and restart a proxy
# at another commit (run-proxy --when-idle). The launch waits for it, so it
# should return quickly. After a move this runs again, once, from the new
# checkout. A prelaunch that fails fails no launch.
if [[ -n ${SHAVER_PRELAUNCHED:-} ]]; then
  unset SHAVER_PRELAUNCHED
elif [[ -n ${SHAVER_PRELAUNCH:-} ]]; then
  head=$(git -C "$bin" rev-parse HEAD 2>/dev/null) || head=
  "$SHAVER_PRELAUNCH" --prelaunch claude </dev/null || true
  [[ $(git -C "$bin" rev-parse HEAD 2>/dev/null || :) == "$head" ]] || SHAVER_PRELAUNCHED=1 exec "$me" "$@"
fi

if [[ -n ${SHAVER_REAL_CLAUDE_LOCATIONS:-} ]]; then
  # The first entry with a match wins; within a glob, the newest match.
  real=
  IFS=: read -ra entries <<<"$SHAVER_REAL_CLAUDE_LOCATIONS"
  for e in "${entries[@]}"; do
    while read -r c; do
      [[ -n $c && -x $c && $(readlink -f "$c") != "$me" ]] && real=$c
    done < <(compgen -G "${e/#\~/$HOME}" | sort -V)
    [[ -n $real ]] && break
  done
  [[ -n $real ]] ||
    die "SHAVER_REAL_CLAUDE_LOCATIONS ($SHAVER_REAL_CLAUDE_LOCATIONS) has no executable Claude Code"
else
  # exec keeps the PID, so a parent with the one this last ran `claude` as is
  # that `claude` running this again: a wrapper, which would loop. The depth
  # catches a wrapper that runs this through other processes.
  depth=${SHAVER_DEPTH:-0}
  [[ ${SHAVER_LAUNCHER_PID:-} != "$PPID" && $depth -lt 5 ]] ||
    die "run again by the claude it ran, as a wrapper runs the Claude Code it is given; set SHAVER_REAL_CLAUDE_LOCATIONS (DESIGN.md)"
  export SHAVER_LAUNCHER_PID=$$ SHAVER_DEPTH=$((depth + 1))
  real=("${SHELL:-bash}" -lic 'claude "$@"' claude)
fi

# Percent-encodes all but unreserved characters (RFC 3986), for a path segment.
encode() {
  local LC_ALL=C s=$1 out= c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9.~_-]) out+=$c ;;
      *) printf -v c '%%%02X' "'$c"; out+=$c ;;
    esac
  done
  printf %s "$out"
}

port=${SHAVER_PORT:-18787}
# A proxy that can't start leaves Claude Code to run without it, as it would
# with no proxy, rather than not at all. A base URL at the proxy (one a shell
# inherited from a session run through it, say) would fail, so it is put back
# to the gateway in its /via/, or dropped when it has none. The pause is for the
# warning to be read before Claude Code takes the terminal.
if ! "$bin/run-proxy"; then
  echo "claude-via-shaver: the proxy did not start; running Claude Code without it" >&2
  if [[ ${ANTHROPIC_BASE_URL:-} =~ ^http://(127\.0\.0\.1|localhost):$port(/|$) ]]; then
    if [[ ${ANTHROPIC_BASE_URL%/} =~ /via/([^/]+)$ ]]; then
      gw=${BASH_REMATCH[1]}
      export ANTHROPIC_BASE_URL=$(printf '%b' "${gw//%/\\x}")
    else
      unset ANTHROPIC_BASE_URL
    fi
  fi
  [[ -t 2 ]] && sleep 3
  exec "${real[@]}" "$@"
fi
up=${ANTHROPIC_BASE_URL:-}
up=${up%/}
# Where Claude Code compacts depends on variables it sends nothing about; those
# set are saved for the proxy, and their ID goes in the base URL
# (src/launch-vals.ts).
id=$("$bin/node-wrapper" "$bin/../src/launch-vals.ts" claude "$bin/../proxy-data" -- "$@")
base=http://127.0.0.1:$port/harness/claude${id:+/launch-vals/$id}
# A base URL already at the proxy (one a shell inherited from a session run
# through it, say) is rebuilt with this launch's ID, keeping its gateway.
if [[ -n $up && ! $up =~ ^http://(127\.0\.0\.1|localhost):$port(/|$) ]]; then
  ANTHROPIC_BASE_URL=$base/via/$(encode "$up")
elif [[ $up =~ /via/[^/]+$ ]]; then
  ANTHROPIC_BASE_URL=$base${BASH_REMATCH[0]}
else
  ANTHROPIC_BASE_URL=$base
fi
# The hint headers say what kind each request is (x-claude-code-request-class),
# so the proxy tells side requests apart without reading their wording.
export ANTHROPIC_BASE_URL CLAUDE_CODE_GATEWAY_HINT_HEADERS=1
# Claude Code turns its tool search off behind a proxy unless ENABLE_TOOL_SEARCH
# is set, so it is set to true where unset, as Claude Code is without one. A
# value already set is kept, so Claude Code searches for tools as it would
# without the proxy; shaver info warns when the search is off, as every tool
# is then sent in full and shaver can defer none.
[[ -n ${ENABLE_TOOL_SEARCH:-} ]] || export ENABLE_TOOL_SEARCH=true
exec "${real[@]}" "$@"
