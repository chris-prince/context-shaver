#!/usr/bin/env bash
# Runs Claude Code through the ctx-shaver proxy, starting the proxy first if
# nothing is listening on its port (bin/run-proxy). Arguments are passed to
# Claude Code. Claude Code turns tool search off behind a proxy unless told the
# proxy forwards it; this one does.
#
# An ANTHROPIC_BASE_URL already set, such as a company gateway, is kept as the
# proxy's upstream for this session, named in the path (src/via.ts); one
# already through this proxy, as a teammate session inherits, is left as it is.
#
# Claude Code is `claude`, or CTX_SHAVER_REAL_CLAUDE_LOCATION if set: a path,
# or a glob of versioned installs, of which the newest is taken. Set it when
# this stands in for Claude Code under a wrapper that sets the base URL itself
# once it starts (DESIGN.md); there, running `claude` would run the wrapper,
# which would run this again.
set -euo pipefail

me=$(readlink -f "$0")
bin=$(dirname "$me")
die() { echo "claude-via-shaver: $*" >&2; exit 1; }

if [[ -n ${CTX_SHAVER_REAL_CLAUDE_LOCATION:-} ]]; then
  real=$(compgen -G "${CTX_SHAVER_REAL_CLAUDE_LOCATION/#\~/$HOME}" | sort -V | tail -1) || true
  [[ -n $real && -x $real && $(readlink -f "$real") != "$me" ]] ||
    die "CTX_SHAVER_REAL_CLAUDE_LOCATION ($CTX_SHAVER_REAL_CLAUDE_LOCATION) is not an executable Claude Code"
else
  # exec keeps the PID, so a parent with the one this last ran `claude` as is
  # that `claude` running this again: a wrapper, which would loop. The depth
  # catches a wrapper that runs this through other processes.
  depth=${CTX_SHAVER_DEPTH:-0}
  [[ ${CTX_SHAVER_LAUNCHER_PID:-} != "$PPID" && $depth -lt 5 ]] ||
    die "run again by the claude it ran, as a wrapper runs the Claude Code it is given; set CTX_SHAVER_REAL_CLAUDE_LOCATION (DESIGN.md)"
  export CTX_SHAVER_LAUNCHER_PID=$$ CTX_SHAVER_DEPTH=$((depth + 1))
  real=claude
fi

# Percent-encodes all but unreserved characters (RFC 3986), for a path segment.
encode() {
  local LC_ALL=C s=$1 out= c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9.~_-]) out+=$c ;;
      *) printf -v c '%%%02X' "'$c"; out+=$c ;;
    esac
  done
  printf %s "$out"
}

"$bin/run-proxy"
port=${CTX_SHAVER_PORT:-8787} up=${ANTHROPIC_BASE_URL:-}
up=${up%/}
if [[ -z $up ]]; then
  ANTHROPIC_BASE_URL=http://127.0.0.1:$port
elif [[ ! $up =~ ^http://(127\.0\.0\.1|localhost):$port(/|$) ]]; then
  ANTHROPIC_BASE_URL=http://127.0.0.1:$port/via/$(encode "$up")
fi
export ANTHROPIC_BASE_URL ENABLE_TOOL_SEARCH=${ENABLE_TOOL_SEARCH:-true}
exec "$real" "$@"
