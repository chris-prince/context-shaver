#!/usr/bin/env bash
# Runs OpenCode through the context-shaver proxy, starting the proxy first if
# nothing is listening on its port (bin/run-proxy). Arguments are passed to
# OpenCode.
#
# OPENCODE_CONFIG_CONTENT points the OpenRouter, OpenAI and Anthropic providers
# at the proxy and is merged over OpenCode's config, which is left alone. OpenCode's background
# service doesn't read it, so the TUI, `run` and `mini` get --standalone, a
# private server that does; other subcommands are passed as they are.
#
# OpenCode is `opencode` as typed at your prompt, run by your login shell so an
# alias or function for it there applies (one that keeps the machine awake, say).
set -euo pipefail

bin=$(dirname "$(readlink -f "$0")")
die() { echo "opencode-via-shaver: $*" >&2; exit 1; }
# As in claude-via-shaver: a parent with the PID this last ran `opencode` as is
# that `opencode` running this again, an alias or wrapper, which would loop.
depth=${SHAVER_DEPTH:-0}
[[ ${SHAVER_LAUNCHER_PID:-} != "$PPID" && $depth -lt 5 ]] ||
  die "run again by the opencode it ran; \`opencode\` at your prompt must not run this"
export SHAVER_LAUNCHER_PID=$$ SHAVER_DEPTH=$((depth + 1))
real=("${SHELL:-bash}" -lic 'opencode "$@"' opencode)
# As in claude-via-shaver: a proxy that can't start leaves OpenCode to run
# without it, its config as it is.
if ! "$bin/run-proxy"; then
  echo "opencode-via-shaver: the proxy did not start; running OpenCode without it" >&2
  [[ -t 2 ]] && sleep 3
  exec "${real[@]}" "$@"
fi
port=${SHAVER_PORT:-18787}
# What says where OpenCode compacts and that the proxy can't see itself, the
# variables that move its config and the compaction settings and model limits
# of the user's own OPENCODE_CONFIG_CONTENT, is saved for the proxy, and its
# ID goes in the base URLs (src/launch-vals.ts).
id=$("$bin/node-wrapper" "$bin/../src/launch-vals.ts" opencode "$bin/../proxy-data" -- "$@")
# Our providers are merged over the user's own OPENCODE_CONFIG_CONTENT, which
# would otherwise be lost; one that isn't JSON is dropped, with a warning.
OPENCODE_CONFIG_CONTENT=$(node -e '
const [user, base] = process.argv.slice(1)
const isObj = (v) => v !== null && typeof v === "object" && !Array.isArray(v)
const merge = (a, b) => isObj(a) && isObj(b) ? Object.fromEntries([...new Set([...Object.keys(a), ...Object.keys(b)])].map((k) => [k, k in b ? merge(a[k], b[k]) : a[k]])) : b
let mine = {}
if (user) try { mine = JSON.parse(user) } catch { console.error("opencode-via-shaver: OPENCODE_CONFIG_CONTENT is not JSON, so it is left out") }
if (!isObj(mine)) mine = {}
const via = (up) => ({ options: { baseURL: `${base}/via/${encodeURIComponent(up)}` } })
const ours = { provider: { openrouter: via("https://openrouter.ai/api/v1"), openai: via("https://api.openai.com/v1"), anthropic: via("https://api.anthropic.com/v1") } }
console.log(JSON.stringify(merge(mine, ours)))
' "${OPENCODE_CONFIG_CONTENT:-}" "http://127.0.0.1:$port/harness/opencode${id:+/launch-vals/$id}")
export OPENCODE_CONFIG_CONTENT
case ${1:-} in
  run | mini) exec "${real[@]}" "$1" --standalone "${@:2}" ;;
  "" | -* ) exec "${real[@]}" --standalone "$@" ;;
  *) [[ -d $1 ]] && exec "${real[@]}" --standalone "$@"; exec "${real[@]}" "$@" ;;
esac
