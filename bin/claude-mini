#!/bin/bash
# Runs claude through the mini-context proxy, starting the proxy first if
# nothing is listening on its port (bin/start-proxy). Arguments are passed to
# claude.
set -euo pipefail

bin=$(dirname "$(readlink -f "$0")")
"$bin/start-proxy"
ANTHROPIC_BASE_URL=http://127.0.0.1:${MINI_CTX_PORT:-8787} exec claude "$@"
