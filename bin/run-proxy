#!/usr/bin/env bash
# Starts the context-shaver proxy if nothing is listening on its port, and leaves
# it running; its output goes to proxy-data/proxy.log. A proxy already there that
# runs from another repo, or is too old to say, is restarted from this one. With
# --restart, asks the proxy there to stop first, so a new one picks up code and
# policy changes.
# Sessions running through it resume with their next request, once it is back
# up. With --stop, only stops it. With --log, the proxy it starts logs every
# request under proxy-data/logs/; with --no-log, it doesn't. With neither, a
# proxy that replaces a running one keeps that one's logging. It runs the proxy on Node 24 or newer, through
# bin/node-wrapper, which installs one if need be.
set -euo pipefail

repo=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
port=${CTX_SHAVER_PORT:-8787}
action= log=() logset=
for arg; do
  case $arg in
    --restart | --stop) action=$arg ;;
    --log) log=(--log-step-events) logset=1 ;;
    --no-log) log=() logset=1 ;;
    *) echo "usage: run-proxy [--restart | --stop] [--log | --no-log]" >&2; exit 2 ;;
  esac
done
# True if anything accepts a connection, through bash's own /dev/tcp (no nc).
up() { (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; }
# Asks the proxy to exit (server.ts), so no lsof is needed to find its PID.
stop() {
  (exec 3<>"/dev/tcp/127.0.0.1/$port" &&
    printf 'POST /ctx-shaver/shutdown HTTP/1.1\r\nHost: 127.0.0.1\r\nx-ctx-shaver: shutdown\r\nContent-Length: 0\r\nConnection: close\r\n\r\n' >&3 &&
    while read -r -t 5 _ <&3; do :; done) 2>/dev/null || true
}
# What the proxy on the port says about itself (server.ts), as lines of
# "context-shaver <field>: <value>"; nothing from one that doesn't say.
procinfo() {
  (exec 3<>"/dev/tcp/127.0.0.1/$port" &&
    printf 'GET /ctx-shaver/procinfo HTTP/1.1\r\nHost: 127.0.0.1\r\nx-ctx-shaver: procinfo\r\nConnection: close\r\n\r\n' >&3 &&
    while IFS= read -r -t 5 line <&3; do
      line=${line%$'\r'}
      [[ $line == "context-shaver "*": "* ]] && echo "${line#context-shaver }"
    done) 2>/dev/null || true
}

info=
up && info=$(procinfo)
if [[ -z $action ]] && up; then
  other=$(sed -n 's/^repo: //p' <<<"$info")
  if [[ $other != "$repo" ]]; then
    from=${other:-"an older checkout, or is not one"}
    echo "run-proxy: the proxy on port $port runs from $from; restarting it from $repo" >&2
    action=--restart
  fi
fi
# A proxy that replaces a running one keeps its logging unless told otherwise.
[[ -n $action && -z $logset && $(sed -n 's/^logging: //p' <<<"$info") == on ]] && log=(--log-step-events)
if [[ -n $action ]] && up; then
  stop
  for _ in $(seq 50); do up || break; sleep 0.1; done
  ! up || { echo "run-proxy: the proxy on port $port did not stop" >&2; exit 1; }
fi
[[ $action == --stop ]] && exit 0

if ! up; then
  mkdir -p "$repo/proxy-data"
  "$repo/bin/node-wrapper" --nohup "$repo/proxy-data/proxy.log" \
    "$repo/src/server.ts" --port "$port" ${log[@]+"${log[@]}"}
  for _ in $(seq 50); do up && break; sleep 0.1; done
  up || { echo "run-proxy: the proxy did not start; see $repo/proxy-data/proxy.log" >&2; exit 1; }
fi
