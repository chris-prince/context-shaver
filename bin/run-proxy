#!/usr/bin/env bash
# Starts the context-shaver proxy if nothing is listening on its port, and leaves
# it running; its output goes to proxy-data/proxy.log. A proxy already there that
# runs from another repo is restarted from this one; anything else there that
# doesn't say what it is is another program, and stops this with an error. With
# --restart, asks the proxy there to stop first, so a new one picks up code and
# policy changes.
# Sessions running through it resume with their next request, once it is back
# up. With --stop, only stops it. With --update, fast-forwards this repo to its
# upstream first, and restarts the proxy if it then runs another commit. With
# --log, the proxy it starts logs every request under proxy-data/logs/; with
# --no-log, it doesn't. With neither, a proxy that replaces a running one keeps
# that one's logging. It runs the proxy on Node 24 or newer, through
# bin/node-wrapper, which installs one if need be.
set -euo pipefail

repo=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
port=${SHAVER_PORT:-18787}
action= log=() logset=
for arg; do
  case $arg in
    --restart | --stop | --update) action=$arg ;;
    --log) log=(--log-step-events) logset=1 ;;
    --no-log) log=() logset=1 ;;
    *) echo "usage: run-proxy [--restart | --stop | --update] [--log | --no-log]" >&2; exit 2 ;;
  esac
done
# Fetch and fast-forward rather than pull, so no pull.* setting changes what
# happens. A failure (local changes in the way, or diverged history) stops
# here, leaving the running proxy alone.
if [[ $action == --update ]]; then
  before=$(git -C "$repo" rev-parse HEAD)
  git -C "$repo" fetch --quiet
  git -C "$repo" merge --ff-only --quiet '@{upstream}'
  action= updating=1
  if [[ $(git -C "$repo" rev-parse HEAD) != "$before" ]]; then
    action=--restart
    n=$(git -C "$repo" rev-list --count "$before..HEAD")
    echo "run-proxy: updated to $(git -C "$repo" log -1 --format='%h') ($n new commit$( ((n == 1)) || echo s))"
  fi
fi
# True if anything accepts a connection, through bash's own /dev/tcp (no nc).
up() { (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; }
# Asks the proxy to exit (server.ts), so no lsof is needed to find its PID.
stop() {
  (exec 3<>"/dev/tcp/127.0.0.1/$port" &&
    printf 'POST /shaver/shutdown HTTP/1.1\r\nHost: 127.0.0.1\r\nx-shaver: shutdown\r\nContent-Length: 0\r\nConnection: close\r\n\r\n' >&3 &&
    while read -r -t 5 _ <&3; do :; done) 2>/dev/null || true
}
# What the proxy on the port says about itself (server.ts), as lines of
# "shaver <field>: <value>"; nothing from one that doesn't say.
procinfo() {
  (exec 3<>"/dev/tcp/127.0.0.1/$port" &&
    printf 'GET /shaver/procinfo HTTP/1.1\r\nHost: 127.0.0.1\r\nx-shaver: procinfo\r\nConnection: close\r\n\r\n' >&3 &&
    while IFS= read -r -t 5 line <&3; do
      line=${line%$'\r'}
      [[ $line == "shaver "*": "* ]] && echo "${line#shaver }"
    done) 2>/dev/null || true
}

info=
up && info=$(procinfo)
# Something there that doesn't say what it is isn't a proxy, so it's left alone.
if up && [[ -z $info ]]; then
  echo "run-proxy: port $port is in use by another program. Set SHAVER_PORT=NNNN to an available port number." >&2
  exit 1
fi
if [[ -z $action ]] && up; then
  other=$(sed -n 's/^repo: //p' <<<"$info")
  if [[ $other != "$repo" ]]; then
    echo "run-proxy: the proxy on port $port runs from $other; restarting it from $repo" >&2
    action=--restart
  # This repo's proxy, started before the checkout moved (a pull without
  # --update, say): --update restarts it, and otherwise it's left running, since
  # a restart would cut off a reply another session is streaming.
  elif ran=$(sed -n 's/^commit: //p' <<<"$info"); [[ $ran != "$(git -C "$repo" rev-parse HEAD 2>/dev/null)" ]]; then
    if [[ -n ${updating-} ]]; then action=--restart
    else
      # A proxy from before it reported its commit says none.
      what="commit ${ran:0:7}"; [[ -n $ran ]] || what="an older commit"
      echo "run-proxy: the proxy on port $port runs $what, but the checkout is at $(git -C "$repo" rev-parse --short=7 HEAD). To switch, run bin/run-proxy --restart (or --update, which also pulls) when no session is mid-reply." >&2
    fi
  fi
fi
# A proxy that replaces a running one keeps its logging unless told otherwise.
[[ -n $action && -z $logset && $(sed -n 's/^logging: //p' <<<"$info") == on ]] && log=(--log-step-events)
if [[ -n $action ]] && up; then
  stop
  for _ in $(seq 50); do up || break; sleep 0.1; done
  ! up || { echo "run-proxy: the proxy on port $port did not stop" >&2; exit 1; }
fi
[[ $action == --stop ]] && exit 0

if ! up; then
  mkdir -p "$repo/proxy-data"
  "$repo/bin/node-wrapper" --nohup "$repo/proxy-data/proxy.log" \
    "$repo/src/server.ts" --port "$port" ${log[@]+"${log[@]}"}
  for _ in $(seq 50); do up && break; sleep 0.1; done
  # The proxy's own reason, when it gave one (a port in use) as its last line;
  # the log is appended to, so an earlier run's line doesn't count.
  up || { echo "run-proxy: the proxy did not start; see $repo/proxy-data/proxy.log" >&2
    tail -n 1 "$repo/proxy-data/proxy.log" | sed -n 's/^shaver: \(port .* in use .*\)/run-proxy: \1/p' >&2; exit 1; }
fi
