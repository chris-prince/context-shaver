#!/usr/bin/env bash
# Runs Node 24 or newer, which runs this repo's TypeScript directly, with the
# arguments given: one installed under proxy-data/node if there is one, else the
# `node` on the PATH if it is new enough. Otherwise it first installs one there
# with npm (node@24 from npm's registry). If that fails, as where the default
# registry is blocked, it lists the registries that .npmrc files on this machine
# name, and on a terminal asks which to install from; it uses none unasked.
# With SHAVER_INSTALL_DEPS=1, it asks nothing and tries each of them in turn.
#
# With --nohup <log>, it starts Node in the background, apart from the
# terminal, with its output appended to the log, and returns; any install comes
# first, in the foreground, so it can still ask. (Backgrounded or redirected by
# the caller, it could not: bash gives a script's background job no terminal to
# read.)
#
# A version manager's shim (nodenv, asdf, mise) as `node` or `npm` picks the
# version by the directory it runs in, where a file such as .node-version may
# name one not installed. So a node that fails from the caller's directory is
# tried again from this repo's, npm runs from there, and the Node found runs by
# its own path, from the caller's directory.
set -euo pipefail

repo=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
dir=$repo/proxy-data/node
PATH=$dir/bin:$PATH
die() { echo "node-wrapper: $*" >&2; exit 1; }
log=
auto=${SHAVER_INSTALL_DEPS:-}
if [[ ${1:-} == --nohup ]]; then
  [[ $# -ge 3 ]] || die "usage: node-wrapper [--nohup <log>] <node arguments>"
  log=$2
  shift 2
fi

# Sets $node to the path of a Node 24 or newer, as found from the caller's
# directory or else this repo's.
node=
ok() {
  local d
  for d in "$PWD" "$repo"; do
    node=$(cd "$d" && node -p 'process.versions.node.split(".")[0] >= 24 ? process.execPath : ""' 2>/dev/null) &&
      [[ -n $node ]] && return
  done
  node=
  return 1
}
npm() { (cd "$repo" && command npm "$@"); }
# npm's output goes to $out, shown only if every try fails.
install() { npm install -g --prefix "$dir" "$@" node@24 >"$out" 2>&1 && ok; }

# Prints the paths of .npmrc files under $1, at most $2 levels down.
search() {
  if command -v rg >/dev/null; then
    rg --files -uu -g .npmrc --max-depth "$2" "$1" 2>/dev/null || true
  else
    find "$1" -maxdepth "$2" -name .npmrc -type f 2>/dev/null || true
  fi
}

# Lists the default registries (registry=, not @scope:registry=) that .npmrc
# files name, under / to depth 4 (as /src/<repo>/.npmrc) and $HOME to depth 4
# (as ~/src/<org>/<repo>/.npmrc); each registry once, with the first file that
# names it, so a file reached by two paths, as through a bind mount, is listed
# once. On a terminal, asks for one and prints it; with $auto set, prints them
# all, one per line, without asking.
pick() {
  local f r n seen=" " files=() regs=()
  while IFS= read -r f; do
    # npm takes the last registry= line.
    r=$(sed -nE 's/^[[:space:]]*registry[[:space:]]*=[[:space:]]*([^[:space:]]+).*/\1/p' "$f" 2>/dev/null | tail -n1)
    [[ -z $r || $seen == *" $r "* ]] && continue
    seen+="$r "
    files+=("$f") regs+=("$r")
  done < <({ search / 4; search "$HOME" 4; } | sort -u)
  ((${#files[@]})) || return 1
  {
    echo "node-wrapper: npm could not install it from $(npm config get registry)."
    if ((${#files[@]} == 1)); then
      echo "This .npmrc file on this machine names another registry:"
    else
      echo "These .npmrc files on this machine name other registries:"
    fi
    for n in "${!files[@]}"; do
      printf '  %d) %s\n       registry=%s\n' $((n + 1)) "${files[n]}" "${regs[n]}"
    done
  } >&2
  if [[ -n $auto ]]; then
    printf '%s\n' "${regs[@]}"
    return
  fi
  [[ -t 0 ]] || return 1
  if ((${#files[@]} == 1)); then
    read -rp "Install Node 24 from it? [y/N] " n
    [[ $n == [yY]* ]] && n=1 || return 1
  else
    read -rp "Type number to use for Node 24 install, or Enter to stop: " n
    [[ $n =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#files[@]})) || return 1
  fi
  echo "${regs[n - 1]}"
}

if ! ok; then
  type -P npm >/dev/null || die "Node 24 or newer is needed, and there is no npm to install it with"
  out=$(mktemp)
  # One that can't run at all, as a shim for a version not installed, is no
  # registry's fault, so none is offered.
  npm --version >"$out" 2>&1 || {
    cat "$out" >&2
    rm -f "$out"
    die "Node 24 or newer is needed, and npm does not run here to install it"
  }
  echo "node-wrapper: Node 24 or newer is needed; installing it under $dir with npm" >&2
  # Default registry first, then those pick gives (none when it gives none).
  tried() {
    install && return
    local r
    for r in $(pick); do
      echo "node-wrapper: trying $r" >&2
      install --registry="$r" && return
    done
    return 1
  }
  tried || {
    cat "$out" >&2
    rm -f "$out"
    die "could not install Node 24; set a registry npm can reach (npm config set registry <url>)"
  }
  rm -f "$out"
  echo "node-wrapper: installed Node $("$node" -v)" >&2
fi
if [[ -n $log ]]; then
  # Node restores SIGHUP's default, undoing nohup; the proxy ignores it itself.
  nohup "$node" "$@" >>"$log" 2>&1 </dev/null &
else
  exec "$node" "$@"
fi
