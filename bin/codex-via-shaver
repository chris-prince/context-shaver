#!/usr/bin/env bash
# Runs Codex through the context-shaver proxy, starting the proxy first if nothing
# is listening on its port (bin/run-proxy). Arguments are passed to Codex.
#
# The proxy is a provider set with -c flags, so Codex's config is left alone.
# It speaks Responses to ChatGPT's Codex backend with the ChatGPT login, with
# WebSockets off: Codex tries one first otherwise, which the proxy refuses.
#
# A provider already chosen in the arguments, as a wrapper does for a company
# gateway, is kept instead: its base_url becomes the proxy's, with the gateway
# as the upstream for this session, named in the path (src/via.ts), and only
# its WebSockets are turned off. One already through this proxy is left as it is.
#
# Codex is `codex` as typed at your prompt, run by your login shell so an alias
# or function for it there applies (one that keeps the machine awake, say), or
# SHAVER_REAL_CODEX_LOCATIONS if set: paths, or globs of versioned installs,
# separated by colons; the first with a match is taken, and of a glob's matches
# the newest. Set it when this stands
# in for Codex under a wrapper that passes the provider itself once it starts
# (DESIGN.md); there, running `codex` would run the wrapper, which would run
# this again.
set -euo pipefail

me=$(readlink -f "$0")
bin=$(dirname "$me")
die() { echo "codex-via-shaver: $*" >&2; exit 1; }

if [[ -n ${SHAVER_REAL_CODEX_LOCATIONS:-} ]]; then
  # The first entry with a match wins; within a glob, the newest match.
  real=
  IFS=: read -ra entries <<<"$SHAVER_REAL_CODEX_LOCATIONS"
  for e in "${entries[@]}"; do
    while read -r c; do
      [[ -n $c && -x $c && $(readlink -f "$c") != "$me" ]] && real=$c
    done < <(compgen -G "${e/#\~/$HOME}" | sort -V)
    [[ -n $real ]] && break
  done
  [[ -n $real ]] ||
    die "SHAVER_REAL_CODEX_LOCATIONS ($SHAVER_REAL_CODEX_LOCATIONS) has no executable Codex"
else
  # As in claude-via-shaver: a parent with the PID this last ran `codex` as is
  # that `codex` running this again, a wrapper, which would loop.
  depth=${SHAVER_DEPTH:-0}
  [[ ${SHAVER_LAUNCHER_PID:-} != "$PPID" && $depth -lt 5 ]] ||
    die "run again by the codex it ran, as a wrapper runs the Codex it is given; set SHAVER_REAL_CODEX_LOCATIONS (DESIGN.md)"
  export SHAVER_LAUNCHER_PID=$$ SHAVER_DEPTH=$((depth + 1))
  real=("${SHELL:-bash}" -lic 'codex "$@"' codex)
fi

# --stand-in prints a Codex for a wrapper to be given in place of the real one,
# for a wrapper that wants the files beside its Codex, as an install has:
# a directory of links to all beside the real Codex, in which Codex itself is
# a script running this with that Codex. A link to this would not do, as a
# wrapper following it would look beside this instead.
if [[ ${1:-} == --stand-in ]]; then
  [[ -n ${SHAVER_REAL_CODEX_LOCATIONS:-} ]] || die "--stand-in needs SHAVER_REAL_CODEX_LOCATIONS"
  real=$(readlink -f "$real")
  from=$(dirname "$real")
  dir=$bin/../proxy-data/stand-in/$(printf %s "$from" | cksum | cut -d' ' -f1)
  stub=$dir/$(basename "$real")
  script=$(printf '#!/usr/bin/env bash\nexport SHAVER_REAL_CODEX_LOCATIONS=%q\nexec %q "$@"' \
    "$real" "$me")
  # As an install is not changed in place, one made for it already will do.
  if [[ ! -x $stub || $(<"$stub") != "$script" ]]; then
    mkdir -p "$dir"
    for f in "$from"/* "$from"/.[!.]*; do
      [[ -e $f && $f != "$real" ]] && ln -sfn "$f" "$dir/"
    done
    printf '%s\n' "$script" > "$stub.$$"
    chmod +x "$stub.$$"
    mv -f "$stub.$$" "$stub"
  fi
  readlink -f "$stub"
  exit
fi

# Percent-encodes all but unreserved characters (RFC 3986), for a path segment.
encode() {
  local LC_ALL=C s=$1 out= c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9.~_-]) out+=$c ;;
      *) printf -v c '%%%02X' "'$c"; out+=$c ;;
    esac
  done
  printf %s "$out"
}

"$bin/run-proxy"
port=${SHAVER_PORT:-8787}

# Where the last -c/--config value for a key is in args, as the last wins in
# Codex, or nothing. Each is "-c key=value", "--config key=value" or
# "--config=key=value".
args=("$@")
last() {
  local i a v found=
  for ((i = 0; i < ${#args[@]}; i++)); do
    a=${args[i]}
    case $a in
      --) break ;;
      -c | --config) ((++i < ${#args[@]})) || break; v=${args[i]} ;;
      --config=*) v=${a#--config=} ;;
      *) continue ;;
    esac
    [[ ${v%%=*} == "$1" ]] && found=$i
  done
  printf %s "$found"
}
# A value as given, without the quotes TOML may have around it.
value() {
  local v=${args[$1]#--config=}
  v=${v#*=}
  [[ $v =~ ^\"(.*)\"$ || $v =~ ^\'(.*)\'$ ]] && v=${BASH_REMATCH[1]}
  printf %s "$v"
}

j=$(last model_provider)
if [[ -z $j ]]; then
  exec "${real[@]}" \
    -c model_provider=shaver \
    -c model_providers.shaver.name=shaver \
    -c "model_providers.shaver.base_url=\"http://127.0.0.1:$port/harness/codex/via/https%3A%2F%2Fchatgpt.com%2Fbackend-api%2Fcodex\"" \
    -c model_providers.shaver.wire_api=responses \
    -c model_providers.shaver.requires_openai_auth=true \
    -c model_providers.shaver.supports_websockets=false \
    "$@"
fi

provider=$(value "$j")
key=model_providers.$provider.base_url
j=$(last "$key")
[[ -n $j ]] || die "model_provider is $provider, but no $key is given to chain to"
up=$(value "$j")
up=${up%/}
if [[ ! $up =~ ^http://(127\.0\.0\.1|localhost):$port(/|$) ]]; then
  v="$key=\"http://127.0.0.1:$port/harness/codex/via/$(encode "$up")\""
  [[ ${args[j]} == --config=* ]] && v=--config=$v
  args[j]=$v
fi
# Right after the base URL, so among the same flags, before any subcommand.
args=("${args[@]:0:j+1}" -c "model_providers.$provider.supports_websockets=false" "${args[@]:j+1}")
exec "${real[@]}" "${args[@]}"
