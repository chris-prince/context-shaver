{
  "conversation_shaver_rules": {
    "tool": [
      { "action": "drop", "after": "4 request" },
      { "action": "drop", "after": "2 turn" }
    ],
    "skill": [
      { "action": "stub", "after": "10 request" },
      { "action": "drop", "after": "100 request" }
    ],
    "tool_search": [
      { "action": "drop", "after": "10 turn" }
    ],
    "reasoning": [
      { "action": "drop", "after": "0 turn" }
    ],
    "prompt_and_assistant_text": { "summary_threshold_tokens": 20000, "memoir_threshold_tokens": 15000 }
  },
  "tool_shaver_rules": {
    "claude": [
      { "name": "*", "action": "defer" }
    ]
  },
  "skill_shaver_rules": [
    { "name": "*", "action": "keep" }
  ]
}
