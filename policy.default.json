{
  "conversation_shaver_rules": {
    "tool": [
      { "action": "drop", "after": "4 requests" },
      { "action": "drop", "after": "2 turns" }
    ],
    "skill": [
      { "action": "stub", "after": "10 requests" },
      { "action": "drop", "after": "100 requests" }
    ],
    "tool_search": [
      { "action": "drop", "after": "10 turns" }
    ],
    "reasoning": [
      { "action": "drop", "after": "0 turns" }
    ],
    "user_and_assistant_text": { "summary_threshold_tokens": 20000, "memoir_threshold_tokens": 15000 }
  },
  "tool_shaver_rules": {
    "claude": []
  },
  "skill_shaver_rules": []
}
