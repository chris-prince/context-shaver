{
  "conversation_shaver_rules": {
    "tool": [
      { "after": "4 request", "action": "drop" },
      { "after": "2 turn", "action": "drop" }
    ],
    "skill": [
      { "after": "10 request", "action": "stub" },
      { "after": "100 request", "action": "drop" }
    ],
    "tool_search": [
      { "after": "10 turn", "action": "drop" }
    ],
    "reasoning": [
      { "after": "0 turn", "action": "drop" }
    ],
    "prompt_and_assistant_text": { "summary_threshold_tokens": 20000, "memoir_threshold_tokens": 15000 }
  },
  "tool_shaver_rules": {
    "claude": [
      { "name": "*", "action": "defer" }
    ]
  },
  "skill_shaver_rules": [
    { "name": "*", "action": "keep" }
  ]
}
