{
  "conversation_shaver_rules": {
    "file_read_calls": [
      { "action": "drop", "eligible_after": "4 requests" },
      { "action": "drop", "eligible_after": "2 turns" }
    ],
    "file_edit_calls": [
      { "action": "drop", "eligible_after": "4 requests" },
      { "action": "drop", "eligible_after": "2 turns" }
    ],
    "shell_calls": [
      { "action": "drop", "eligible_after": "4 requests" },
      { "action": "drop", "eligible_after": "2 turns" }
    ],
    "web_calls": [
      { "action": "drop", "eligible_after": "4 requests" },
      { "action": "drop", "eligible_after": "2 turns" }
    ],
    "skill_calls": [
      { "action": "stub", "eligible_after": "10 requests" },
      { "action": "drop", "eligible_after": "100 requests" }
    ],
    "tool_search_calls": [
      { "action": "drop", "eligible_after": "10 turns" }
    ],
    "other_tool_calls": [
      { "action": "drop", "eligible_after": "4 requests" },
      { "action": "drop", "eligible_after": "2 turns" }
    ],
    "reasoning": [
      { "action": "drop", "eligible_after": "0 turns" },
      { "action": "drop", "eligible_after": "20000 tokens" }
    ],
    "user_and_assistant_text": { "summary_threshold_tokens": 15000, "memoir_threshold_tokens": 15000 }
  },
  "tool_shaver_rules": {
    "claude": []
  },
  "skill_shaver_rules": []
}
